local function textLabel(text, height)
    return create("TextLabel", {
        Size = UDim2.new(1, 0, 0, height or 35),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, content)
end

local function actionButton(text, callback)
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = BG,
        Text = text,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextWrapped = true,
    }, content)

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
    button.Activated:Connect(callback)
    return button
end

local function toggleButton(title, key, callback)
    local button
    local function update()
        button.Text = title .. ": " .. (state[key] and "ON" or "OFF")
        button.TextColor3 = state[key] and GREEN or WHITE
    end

    button = actionButton(title, function()
        state[key] = not state[key]
        update()
        if callback then callback(state[key]) end
    end)
    update()
end

-- ESP: highlight tagged objects locally
local function clearESP(tag)
    for obj, entry in pairs(espObjects) do
        if entry.tag == tag then
            if entry.highlight then entry.highlight:Destroy() end
            if entry.billboard then entry.billboard:Destroy() end
            espObjects[obj] = nil
        end
    end
end

local function updateESP(tag, enabled, color)
    clearESP(tag)
    if not enabled then return end

    for _, obj in ipairs(CollectionService:GetTagged(tag)) do
        if obj:IsDescendantOf(workspace) then
            local target = obj:IsA("Model") and
                (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true))
                or (obj:IsA("BasePart") and obj)

            if target then
                local highlight = Instance.new("Highlight")
                highlight.FillColor = color
                highlight.OutlineColor = WHITE
                highlight.FillTransparency = 0.55
                highlight.Adornee = obj
                highlight.Parent = gui

                local billboard = Instance.new("BillboardGui")
                billboard.Size = UDim2.fromOffset(140, 30)
                billboard.StudsOffset = Vector3.new(0, 3, 0)
                billboard.AlwaysOnTop = true
                billboard.Adornee = target
                billboard.Parent = gui

                create("TextLabel", {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Text = obj.Name,
                    TextColor3 = color,
                    TextStrokeTransparency = 0.25,
                    Font = Enum.Font.GothamBold,
                    TextSize = 13,
                }, billboard)

                espObjects[obj] = {
                    highlight = highlight,
                    billboard = billboard,
                    tag = tag,
                }
            end
        end
    end
end

