
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local YOUTUBE_URL = "https://www.youtube.com/watch?v=DEINE_VIDEO_ID"

local gui = Instance.new("ScreenGui")
gui.Name = "YouTubeScreen"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(420, 250)
frame.Position = UDim2.new(0.5, -210, 0.5, -125)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 45)
title.Position = UDim2.fromOffset(10, 10)
title.BackgroundTransparency = 1
title.Text = "▶ YouTube Player"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 22
title.Font = Enum.Font.GothamBold
title.Parent = frame

local info = Instance.new("TextLabel")
info.Size = UDim2.new(1, -30, 0, 65)
info.Position = UDim2.fromOffset(15, 65)
info.BackgroundTransparency = 1
info.Text = "YouTube-Videos können nicht direkt in einer Roblox-GUI eingebettet werden."
info.TextColor3 = Color3.fromRGB(190, 190, 190)
info.TextWrapped = true
info.TextSize = 15
info.Font = Enum.Font.Gotham
info.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -40, 0, 45)
button.Position = UDim2.fromOffset(20, 155)
button.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
button.Text = "YouTube öffnen"
button.TextColor3 = Color3.new(1, 1, 1)
button.TextSize = 17
button.Font = Enum.Font.GothamBold
button.Parent = frame

Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

button.Activated:Connect(function()
    GuiService:OpenBrowserWindow(YOUTUBE_URL)
end)
