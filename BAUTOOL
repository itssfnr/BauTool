end

local function espTab()
    clearContent()
    textLabel("👁 ESP / RADAR", 30)

    toggleButton("Egg ESP", "espEggs", function(enabled)
        updateESP("Egg", enabled, GREEN)
    end)

    toggleButton("Collectible ESP", "espCollectibles", function(enabled)
        updateESP("Collectible", enabled, Color3.fromRGB(80, 180, 255))
    end)

    actionButton("Clear all ESP", function()
        state.espEggs = false
        state.espCollectibles = false
        clearESP("Egg")
        clearESP("Collectible")
        espTab()
    end)
end

