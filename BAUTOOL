    end)
end

local function eggTab()
    clearContent()
    textLabel("🥚 EGG SYSTEM", 30)
    textLabel("Eggs are detected by the 'Egg' tag.", 35)

    toggleButton("Auto Hatch (UI demo)", "autoHatch", function(enabled)
        textLabel(enabled and
            "Auto Hatch enabled in UI." or "Auto Hatch disabled.", 30)
    end)

    actionButton("List nearby eggs", function()
        local count = 0
        for _, egg in ipairs(CollectionService:GetTagged("Egg")) do
            if egg:IsDescendantOf(workspace) then
                count += 1
                textLabel("🥚 " .. egg.Name, 26)
            end
        end
        if count == 0 then
            textLabel("No objects tagged 'Egg' found.", 35)
        end
    end)

    actionButton("Request hatch (preview only)", function()
        textLabel("Connect this button to your own server hatch system.", 45)
    end)
end

local function petTab()
    clearContent()
    textLabel("🐾 PET MANAGER", 30)
    textLabel("Client-side preview list", 25)

    if #pets == 0 then
        textLabel("No pets loaded. Connect your game's pet data.", 45)
    else
        for _, pet in ipairs(pets) do
            textLabel("🐾 " .. tostring(pet), 28)
        end
    end

    actionButton("Refresh pet preview", function()
        petTab()
    end)
end

local function farmTab()
