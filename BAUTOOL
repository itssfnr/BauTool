--==================================================
-- FLYING CARPET
--==================================================

local flying = false
local flyConnection

button("🪄 Flying Carpet", function()
	local r = root()

	if not r then
		return
	end

	flying = not flying

	if not flying then
		if flyConnection then
			flyConnection:Disconnect()
			flyConnection = nil
		end

		return
	end

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flying then
			return
		end

		local cam = workspace.CurrentCamera
		local direction = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direction += cam.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direction -= cam.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direction -= cam.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direction += cam.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direction += Vector3.yAxis
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			direction -= Vector3.yAxis
		end

		if direction.Magnitude > 0 then
			r.AssemblyLinearVelocity = direction.Unit * 70
		else
			r.AssemblyLinearVelocity = Vector3.zero
		end
	end)
end)

--==================================================
-- LOCAL SWORD
--==================================================

local function createSword()
	local tool = Instance.new("Tool")
	tool.Name = "Sword"
	tool.RequiresHandle = true
	tool.CanBeDropped = false

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 4, 0.4)
	handle.Color = Color3.fromRGB(180, 180, 190)
	handle.Material = Enum.Material.Metal
	handle.Parent = tool

	tool.Activated:Connect(function()
		local r = root()

		if not r then
			return
		end

		for _, obj in ipairs(workspace:GetDescendants()) do
			local h = obj:FindFirstChildOfClass("Humanoid")

			if h and h ~= humanoid() then
				local hrp = obj:FindFirstChild("HumanoidRootPart")

				if hrp and (hrp.Position - r.Position).Magnitude < 8 then
					h:TakeDamage(25)
				end
			end
		end
	end)

	tool.Parent = backpack
end

button("⚔️ Give Sword", createSword)

--==================================================
-- LOCAL BLASTER
--==================================================

local function createBlaster()
	local tool = Instance.new("Tool")
	tool.Name = "Blaster"
	tool.RequiresHandle = true
	tool.CanBeDropped = false

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 1, 2)
	handle.Color = Color3.fromRGB(50, 150, 255)
	handle.Material = Enum.Material.Neon
	handle.Parent = tool

	tool.Activated:Connect(function()
		local cam = workspace.CurrentCamera

		local ray = workspace:Raycast(
			cam.CFrame.Position,
			cam.CFrame.LookVector * 500
		)

		if ray then
			local hit = ray.Instance
			local model = hit:FindFirstAncestorOfClass("Model")

			if model then
				local h = model:FindFirstChildOfClass("Humanoid")

				if h and h ~= humanoid() then
					h:TakeDamage(15)
				end
			end
		end
	end)

	tool.Parent = backpack
end

button("🔫 Give Blaster", createBlaster)

--==================================================
-- GRAPPLING HOOK
--==================================================

local function createGrapple()
	local tool = Instance.new("Tool")
	tool.Name = "Grappling Hook"
	tool.RequiresHandle = true
	tool.CanBeDropped = false

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 1, 1)
	handle.Color = Color3.fromRGB(255, 170, 0)
	handle.Parent = tool

	tool.Activated:Connect(function()
		local r = root()
		local cam = workspace.CurrentCamera

		if not r then
			return
		end

		local ray = workspace:Raycast(
			cam.CFrame.Position,
			cam.CFrame.LookVector * 300
		)

		if ray then
			local difference = ray.Position - r.Position

			if difference.Magnitude > 5 then
				r.AssemblyLinearVelocity =
					difference.Unit * 100
			end
		end
	end)

	tool.Parent = backpack
end

button("🪝 Grappling Hook", createGrapple)

